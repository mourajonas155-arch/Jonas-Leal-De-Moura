Consultas com JOIN e GROUP BY (requisitos do trabalho)
-- -----------------------------------------------------------

-- JOIN: Emprestimos com dados do usuario e funcionario
SELECT
    e.id_emprestimo,
    u.nome AS usuario,
    f.nome AS funcionario,
    e.data_retirada,
    e.data_devolucao_prevista,
    e.status
FROM emprestimo e
JOIN usuario u ON e.cpf = u.cpf
JOIN funcionario f ON e.matricula = f.matricula;

-- GROUP BY: Livros mais emprestados
SELECT
    l.isbn,
    l.titulo,
    COUNT(c.id_emprestimo) AS total_emprestimos
FROM livro l
LEFT JOIN contem c ON l.isbn = c.isbn
GROUP BY l.isbn, l.titulo
ORDER BY total_emprestimos DESC;

-- JOIN + GROUP BY: Total de multas por usuario
SELECT
    u.cpf,
    u.nome,
    COUNT(m.id_multa) AS qtd_multas,
    SUM(m.valor) AS valor_total_multas
FROM usuario u
JOIN emprestimo e ON u.cpf = e.cpf
JOIN multa m ON e.id_emprestimo = m.id_emprestimo
GROUP BY u.cpf, u.nome
ORDER BY valor_total_multas DESC;

-- Relatorio de livros por fornecedor (JOIN + GROUP BY)
SELECT
    f.cnpj,
    f.razao_social,
    COUNT(l.isbn) AS qtd_livros,
    SUM(l.qtd_exemplares) AS total_exemplares
FROM fornecedor f
LEFT JOIN livro l ON f.cnpj = l.cnpj
GROUP BY f.cnpj, f.razao_social;
);

